# Szablon .env dla wdrożenia na mydevil.net.
#
# Docelowe miejsce na serwerze: ~/domains/gdziestanik.lubian.net/data/.env
# (POZA repozytorium — żeby git pull/reset nigdy go nie nadpisał).
#
# Skopiuj ten plik tam i wypełnij prawdziwymi wartościami:
#
#   cp deploy/mydevil/.env.example ~/domains/gdziestanik.lubian.net/data/.env
#   chmod 600 ~/domains/gdziestanik.lubian.net/data/.env

# Wygeneruj np.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Adres domeny, bez protokołu i bez ukośnika na końcu
ALLOWED_HOSTS=gdziestanik.lubian.net
CSRF_TRUSTED_ORIGINS=https://gdziestanik.lubian.net

# Ustaw na 1 DOPIERO po potwierdzeniu, że HTTPS działa poprawnie
# i że zalogowanie się faktycznie ustawia ciasteczko sesji
# (patrz docs/wdrozenie-mydevil.md, sekcja o weryfikacji HTTPS).
# Przedwczesne ustawienie na 1 może uniemożliwić zalogowanie.
HTTPS_CONFIRMED=0

# Zostaw puste, jeśli struktura katalogów jest dokładnie taka jak
# w deploy/mydevil/passenger_wsgi.py — wartości domyślne w
# config/settings/mydevil.py same wyliczą poprawne ścieżki.
# DATA_DIR=/home/mimaczek/domains/gdziestanik.lubian.net/data
# STATIC_ROOT=/home/mimaczek/domains/gdziestanik.lubian.net/public_python/public/static
